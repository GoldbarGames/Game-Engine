#include "MyMenuManager.h"
#include <ENGINE/Game.h>
#include <ENGINE/InputManager.h>

void MyMenuManager::TogglePause(Game& game, bool toggle) const
{
	MenuManager::TogglePause(game, toggle);
}

void MyMenuManager::Init(Game& game) const
{
	// Default keyboard mappings
	defaultKeys["up"] = SDL_SCANCODE_UP;
	defaultKeys["down"] = SDL_SCANCODE_DOWN;
	defaultKeys["left"] = SDL_SCANCODE_LEFT;
	defaultKeys["right"] = SDL_SCANCODE_RIGHT;
	defaultKeys["action"] = SDL_SCANCODE_SPACE;
	defaultKeys["Start"] = SDL_SCANCODE_ESCAPE;

	game.inputManager.SetDefaultKeys(defaultKeys);

	// Default controller mappings
	defaultButtons["up"] = SDL_CONTROLLER_BUTTON_DPAD_UP;
	defaultButtons["down"] = SDL_CONTROLLER_BUTTON_DPAD_DOWN;
	defaultButtons["left"] = SDL_CONTROLLER_BUTTON_DPAD_LEFT;
	defaultButtons["right"] = SDL_CONTROLLER_BUTTON_DPAD_RIGHT;
	defaultButtons["action"] = SDL_CONTROLLER_BUTTON_A;
	defaultButtons["Start"] = SDL_CONTROLLER_BUTTON_START;

	game.inputManager.SetDefaultButtons(defaultButtons);

	MenuManager::Init(game);
}

void MyMenuManager::Update(Game& game) const
{
	MenuManager::Update(game);
}

