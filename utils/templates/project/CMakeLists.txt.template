# CMakeLists.txt for {{WINDOW_TITLE}} - Emscripten/WebAssembly Build
#
# Usage:
#   1. Copy local_config.cmake.example to local_config.cmake
#   2. Edit local_config.cmake with your library paths
#   3. Build:
#      mkdir build_wasm && cd build_wasm
#      emcmake cmake ..
#      emmake cmake --build .
#
# Alternatively, pass paths via command line or environment variables:
#   emcmake cmake .. -DGLM_DIR=/path/to/glm -DNLOHMANN_JSON_DIR=/path/to/nlohmann

cmake_minimum_required(VERSION 3.13)

set(GAME_NAME "{{PROJECT_NAME}}")
set(ENGINE_DIR "${CMAKE_SOURCE_DIR}/../GameEngine")
set(SHELL_TEMPLATE "${ENGINE_DIR}/shell.html")

project(${GAME_NAME} VERSION 1.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "This CMakeLists.txt is for Emscripten builds only.")
endif()

# Load local configuration file if it exists (not committed to git)
if(EXISTS "${CMAKE_SOURCE_DIR}/local_config.cmake")
    include("${CMAKE_SOURCE_DIR}/local_config.cmake")
    message(STATUS "Loaded local_config.cmake")
endif()

# External library paths - can be set via:
# 1. local_config.cmake file (recommended)
# 2. Command line: -DGLM_DIR=/path/to/glm
# 3. Environment variables: GLM_DIR, NLOHMANN_JSON_DIR
if(NOT GLM_DIR)
    set(GLM_DIR "$ENV{GLM_DIR}" CACHE PATH "Path to GLM library")
endif()
if(NOT NLOHMANN_JSON_DIR)
    set(NLOHMANN_JSON_DIR "$ENV{NLOHMANN_JSON_DIR}" CACHE PATH "Path to nlohmann/json")
endif()

if(NOT GLM_DIR OR NOT EXISTS "${GLM_DIR}")
    message(FATAL_ERROR "GLM_DIR not set or does not exist.\n"
        "Option 1: Copy local_config.cmake.example to local_config.cmake and edit it\n"
        "Option 2: emcmake cmake .. -DGLM_DIR=/path/to/glm\n"
        "Option 3: Set GLM_DIR environment variable")
endif()

if(NOT NLOHMANN_JSON_DIR OR NOT EXISTS "${NLOHMANN_JSON_DIR}")
    message(FATAL_ERROR "NLOHMANN_JSON_DIR not set or does not exist.\n"
        "Option 1: Copy local_config.cmake.example to local_config.cmake and edit it\n"
        "Option 2: emcmake cmake .. -DNLOHMANN_JSON_DIR=/path/to/nlohmann\n"
        "Option 3: Set NLOHMANN_JSON_DIR environment variable")
endif()

message(STATUS "Building ${GAME_NAME} for WebAssembly")
message(STATUS "GLM_DIR: ${GLM_DIR}")
message(STATUS "NLOHMANN_JSON_DIR: ${NLOHMANN_JSON_DIR}")

# Collect engine sources
file(GLOB_RECURSE ENGINE_SOURCES "${ENGINE_DIR}/src/ENGINE/*.cpp")

# Game sources - add your own .cpp files to this list as the project grows
set(GAME_SOURCES
    main.cpp
    MyEntity.cpp
    MyEntityFactory.cpp
    MyFileManager.cpp
    MyGUI.cpp
    MyMenuManager.cpp
)

add_executable(${GAME_NAME} ${ENGINE_SOURCES} ${GAME_SOURCES})

target_include_directories(${GAME_NAME} PRIVATE
    ${ENGINE_DIR}/src
    ${ENGINE_DIR}/src/ENGINE
    ${CMAKE_SOURCE_DIR}
    ${GLM_DIR}
    ${NLOHMANN_JSON_DIR}
)

target_compile_definitions(${GAME_NAME} PRIVATE EMSCRIPTEN=1 MAKEDLL=0)

set(EM_FLAGS
    -sUSE_SDL=2
    -sUSE_SDL_IMAGE=2
    -sUSE_SDL_TTF=2
    -sUSE_SDL_MIXER=2
    -sSDL2_IMAGE_FORMATS=["png","jpg"]
)

set(EM_LINK_FLAGS
    ${EM_FLAGS}
    -sWASM=1
    -sALLOW_MEMORY_GROWTH=1
    -sMAX_WEBGL_VERSION=2
    -sMIN_WEBGL_VERSION=2
    -sFULL_ES3=1
    -sNO_EXIT_RUNTIME=1
    -sFETCH=1
    --shell-file=${SHELL_TEMPLATE}
)

# Preload asset directories (only those that exist)
if(EXISTS "${CMAKE_SOURCE_DIR}/data")
    list(APPEND EM_LINK_FLAGS --preload-file=${CMAKE_SOURCE_DIR}/data@/data)
endif()
if(EXISTS "${CMAKE_SOURCE_DIR}/assets")
    list(APPEND EM_LINK_FLAGS --preload-file=${CMAKE_SOURCE_DIR}/assets@/assets)
endif()
if(EXISTS "${CMAKE_SOURCE_DIR}/fonts")
    list(APPEND EM_LINK_FLAGS --preload-file=${CMAKE_SOURCE_DIR}/fonts@/fonts)
endif()
if(EXISTS "${CMAKE_SOURCE_DIR}/bgm")
    list(APPEND EM_LINK_FLAGS --preload-file=${CMAKE_SOURCE_DIR}/bgm@/bgm)
endif()
if(EXISTS "${CMAKE_SOURCE_DIR}/se")
    list(APPEND EM_LINK_FLAGS --preload-file=${CMAKE_SOURCE_DIR}/se@/se)
endif()
if(EXISTS "${CMAKE_SOURCE_DIR}/me")
    list(APPEND EM_LINK_FLAGS --preload-file=${CMAKE_SOURCE_DIR}/me@/me)
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    target_compile_options(${GAME_NAME} PRIVATE ${EM_FLAGS} -g -O0 -w)
    target_link_options(${GAME_NAME} PRIVATE ${EM_LINK_FLAGS} -g -O0 -sASSERTIONS=2)
else()
    target_compile_options(${GAME_NAME} PRIVATE ${EM_FLAGS} -O2 -w)
    target_link_options(${GAME_NAME} PRIVATE ${EM_LINK_FLAGS} -O2)
endif()

set_target_properties(${GAME_NAME} PROPERTIES
    SUFFIX ".html"
    RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/output
)
